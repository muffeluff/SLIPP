{
  "name": "slipp",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-24",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/.netlify/functions/cover"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "SLIPP_DATA",
      "id": "a821390933c34c5fbd1436cb4d6642fa"
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  }
}